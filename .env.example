# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file to GitHub.

# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Where the data lives.
# Leave this out locally and it uses a SQLite file (shortener.db).
# In production Render gives you a real PostgreSQL URL to paste here.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# The public address of your site, used to display full short links.
BASE_URL=http://127.0.0.1:8000
